# ─────────────────────────────────────────────────────────────────────────────
# Zoom USER-LEVEL OAuth app  (Marketplace → Develop → Build App → General App)
#
# NOT Server-to-Server. An S2S token can list schedules but cannot read another
# user's availability and cannot book at all — see docs/api-validation.md.
#
# In the Marketplace app, set the OAuth Redirect URL to exactly ZOOM_REDIRECT_URI
# below and add it to the OAuth allow list.
#
# Scopes to tick (all user-level, no :admin):
#   user:read:user
#   scheduler:read:user
#   scheduler:read:list_schedule
#   scheduler:read:get_schedule            ← also authorises available_times
#   scheduler:write:scheduled_event
#   scheduler:read:scheduled_event
#   scheduler:delete:scheduled_event
#   scheduler:read:list_availability       ← provisioning reads working hours
#   scheduler:write:insert_schedule        ← provisioning creates a booking page
#   meeting:write:meeting                  ← step 3 creates the meeting
#   meeting:read:meeting
#   meeting:delete:meeting                 ← cancellation
#   calendar:read:list_events              ← verify the slot got blocked
# ─────────────────────────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Endpoints — override only for gov/test clusters
ZOOM_OAUTH_AUTHORIZE_URL=https://zoom.us/oauth/authorize
ZOOM_OAUTH_TOKEN_URL=https://zoom.us/oauth/token
ZOOM_API_BASE=https://api.zoom.us/v2

# Encrypts refresh tokens at rest. 32 bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this invalidates the store and every host must reconnect.
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_PATH=.tokens.json

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Demo behaviour
DEFAULT_TIME_ZONE=America/New_York
BOOKING_WINDOW_DAYS=14
LOG_ZOOM_RESPONSES=true
ALLOWED_SCHEDULE_IDS=
AUTO_PROVISION_BOOKING_PAGES=false

# Optional: serve a prebuilt frontend from a custom path. The server auto-detects
# web/dist, so this is only needed for unusual layouts (Docker sets its own).
# WEB_DIST=

# ─── Optional: creating the Marketplace app from the manifest ───
# `npm run app:manifest|app:validate|app:create` — see README.
APP_NAME=Zoom Booking Sample
APP_CONTACT_NAME=
APP_CONTACT_EMAIL=
APP_COMPANY_NAME=

# ─── Optional: a Server-to-Server app used ONLY as a bootstrap ───
# Needed for `npm run app:create` (marketplace:write:app) and `npm run probe:s2s`.
# This is NOT the app the sample authenticates with.
ZOOM_S2S_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=

# smoke.js only — the invitee identity used when run with --book
SMOKE_BOOKER_EMAIL=
SMOKE_BOOKER_FIRST_NAME=Smoke
SMOKE_BOOKER_LAST_NAME=Test
